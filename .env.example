# ===== 复制为 .env 并填写真实值后：docker compose up -d --build =====

# ===== 构建加速（国内服务器建议打开）：npm 和 Alpine 软件源换成国内镜像 =====
NPM_REGISTRY=https://registry.npmmirror.com
ALPINE_MIRROR=https://mirrors.aliyun.com

# 数据库密码（仅容器内网使用，未暴露公网端口）
POSTGRES_PASSWORD=cecs_dev_2026

# JWT 签名密钥（必填，长随机串；泄露可伪造任意账号 token）
JWT_SECRET=请改成至少32位随机字符串

# 加密存库的模型 / 语音密钥（建议设，长随机串）；不设则由 JWT_SECRET 派生，换 JWT_SECRET 后所有密钥都要在管理端重填
SETTINGS_ENCRYPTION_KEY=

# 管理员初始密码（首次登录强制改密）
ADMIN_INITIAL_PASSWORD=Admin#2026

# 跨域来源：客户端从服务器加载页面，和接口同源，生产留空即可（= 不放行任何跨域）；多个用英文逗号分隔
CORS_ORIGINS=

# 学生、教师只能用客户端登录（生产默认开）；临时要在浏览器里验收学生端 / 教师端时设 false
DESKTOP_ONLY=

# ===== LLM 对话（可留空）：只在首次启动时导入为默认模型，之后都在管理端「AI 与语音服务」维护 =====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ===== 语音（火山引擎/豆包，可留空，之后在管理端配置）=====
TTS_API_KEY=
TTS_RESOURCE_ID=seed-tts-2.0
TTS_SPEAKER=zh_female_vv_uranus_bigtts
TTS_SPEAKER_MALE=zh_male_dayi_uranus_bigtts
ASR_RESOURCE_ID=volc.seedasr.sauc.duration
