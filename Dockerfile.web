# 跨境电商客服 AI 实训智能体 —— 前端构建 + nginx 托管（同域反代 /v1 /uploads 到 api）
FROM node:22-alpine AS build
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/portal/package.json apps/portal/
COPY packages/contracts/package.json packages/contracts/
COPY packages/domain/package.json packages/domain/
RUN pnpm install --frozen-lockfile --filter @cecs/portal...

COPY apps/portal apps/portal
COPY packages/contracts packages/contracts
COPY packages/domain packages/domain

# 同域部署：API 走 nginx 反代，前端用相对路径（VITE_API_URL 置空）
ENV VITE_API_URL=""
RUN pnpm --filter @cecs/portal build

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/portal/dist /usr/share/nginx/html
EXPOSE 80
